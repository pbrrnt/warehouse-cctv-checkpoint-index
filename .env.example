# ============================================================
#  ตัวแปรสภาพแวดล้อม — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
#  ★ ห้าม commit ไฟล์ .env เข้า git (มีรหัสผ่าน)
# ============================================================


# ------------------------------------------------------------
#  ข้อมูลไซต์  (ต่างกันทุกโกดัง)
# ------------------------------------------------------------
SITE_ID=WH01
SITE_NAME=โกดังตัวอย่าง
TZ=Asia/Bangkok


# ------------------------------------------------------------
#  ★ เวอร์ชันที่ปักหมุด — ห้ามแก้เป็นรายไซต์
#
#  ทุกโกดังต้องรันเวอร์ชันเดียวกัน ไซต์ที่เวอร์ชันไม่ตรงกัน
#  ทำให้ debug ไม่ได้และเป็นฝันร้ายของการซัพพอร์ต
#  การอัปเดตต้องทดสอบที่ไซต์นำร่องก่อนแล้ว roll out พร้อมกัน
# ------------------------------------------------------------
FRIGATE_VERSION=0.17.2
POSTGRES_VERSION=pg17
REDIS_VERSION=7-alpine
MOSQUITTO_VERSION=2.0


# ------------------------------------------------------------
#  ฐานข้อมูล  (★ สุ่มรหัสผ่านใหม่ทุกไซต์)
#
#  สร้างรหัสผ่าน:  openssl rand -base64 24
# ------------------------------------------------------------
POSTGRES_DB=cctv_index
POSTGRES_USER=cctv
POSTGRES_PASSWORD=CHANGE_ME_ใช้รหัสที่สุ่มมา
POSTGRES_PORT=5432


# ------------------------------------------------------------
#  บัญชีกล้อง
#
#  ★ URL-encode อักขระพิเศษในรหัสผ่าน:
#       @ -> %40      : -> %3A      / -> %2F
#       # -> %23      ? -> %3F      & -> %26
#
#  ตัวอย่าง: รหัสผ่านจริง  P@ss/w0rd
#            ต้องเขียนเป็น  P%40ss%2Fw0rd
#
#  นี่คือสาเหตุอันดับหนึ่งของ "ต่อกล้องไม่ได้ทั้งที่รหัสผ่านถูก"
# ------------------------------------------------------------
CAMERA_USER=admin
CAMERA_PASSWORD=CHANGE_ME_URL_ENCODED

# IP ของกล้องแต่ละตัว (ตั้งเป็น static IP ห้ามใช้ DHCP)
CAM_GATE_LPR_IP=192.168.1.51
CAM_GATE_OVERVIEW_IP=192.168.1.52
CAM_DOOR_FACE_IP=192.168.1.53


# ------------------------------------------------------------
#  NVR  (ใช้อ้างอิงเวลาและบอกผู้ใช้ว่าไปเปิดที่ไหน)
# ------------------------------------------------------------
NVR_HOST=192.168.1.10
NVR_VENDOR=dahua
NVR_RETENTION_DAYS=30


# ------------------------------------------------------------
#  การซิงก์เวลา  (★ ข้อบังคับ — ดู docs/08-nvr-integration.md)
#
#  ถ้าไซต์ไม่มีอินเทอร์เน็ต ให้ตั้งเครื่องนี้เป็น NTP server
#  แล้วชี้ NTP_SERVER มาที่ IP ของเครื่องนี้
# ------------------------------------------------------------
NTP_SERVER=192.168.1.10
TIME_DRIFT_ALERT_SECONDS=2


# ------------------------------------------------------------
#  Retention (วัน)
#
#  ★ ค่าของ face_* ต้องได้รับอนุมัติจากฝ่ายกฎหมายก่อน
#    ดู docs/06-pdpa-compliance.md
#
#  ★ RETENTION_CLIPS_DAYS ต้องตรงกับค่าใน frigate/config.yml
#    (record.alerts.retain.days) — Frigate อ่านค่าจากไฟล์ตัวเอง
#    ไม่ได้อ่านจากที่นี่ ค่าตรงนี้ใช้สำหรับสคริปต์ตรวจสอบเท่านั้น
#
#  ★ RETENTION_BACKUP_DAYS ต้องไม่ยาวกว่า retention ของข้อมูลจริง
#    ไม่งั้นถือว่ายังไม่ได้ลบตาม PDPA
# ------------------------------------------------------------
RETENTION_CLIPS_DAYS=90
RETENTION_SNAPSHOTS_DAYS=365
RETENTION_CROPS_DAYS=365
RETENTION_EVENTS_DAYS=365
RETENTION_FACE_EMBEDDINGS_DAYS=180
RETENTION_AUDIT_LOG_DAYS=1095
RETENTION_BACKUP_DAYS=90


# ------------------------------------------------------------
#  ที่จัดเก็บข้อมูล
# ------------------------------------------------------------
DATA_ROOT=/data
MEDIA_PATH=/data/media
BACKUP_PATH=/data/backups


# ------------------------------------------------------------
#  Frigate
# ------------------------------------------------------------
FRIGATE_PORT=5000
FRIGATE_RTSP_PORT=8554

# preset สำหรับ hardware acceleration ของ Intel:
#   Gen 1-7                        -> preset-vaapi
#   Gen 8-12                       -> preset-vaapi หรือ preset-intel-qsv-h264
#   Gen 13+ / Core Ultra / N100    -> preset-intel-qsv-h264
FFMPEG_HWACCEL_PRESET=preset-intel-qsv-h264

# รหัสผ่าน RTSP restream ของ go2rtc (สุ่มใหม่)
FRIGATE_RTSP_PASSWORD=CHANGE_ME


# ------------------------------------------------------------
#  Services ของเรา (เริ่มใช้เฟส 2)
# ------------------------------------------------------------
API_PORT=8000
# WEB_PORT = พอร์ต HTTPS ที่ผู้ใช้เข้าหน้าเว็บจริง (เช่น https://<ip>:8443)
# WEB_HTTP_PORT = พอร์ต HTTP ที่ redirect ไป HTTPS อย่างเดียว
WEB_PORT=8443
WEB_HTTP_PORT=8080
REDIS_PORT=6379
MQTT_PORT=1883

# จำนวน worker ของ indexer — เพิ่มถ้า Redis Stream ค้างสะสม
INDEXER_WORKERS=2

# กุญแจสำหรับเซ็น session (สุ่มใหม่ทุกไซต์)
API_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
